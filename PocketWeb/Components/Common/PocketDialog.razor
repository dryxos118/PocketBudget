<MudDialog Style="@GetDialogSize()">
    <DialogContent>
        <div class="pocket-divider mb-3"></div>
        @if (DynamicType != null)
        {
            <DynamicComponent @ref="DynamicComponentRef" Type="@DynamicType"
                              Parameters="@TypeParameters"></DynamicComponent>
        }
        <div class="pocket-divider mt-3"></div>
    </DialogContent>
    <DialogActions>
        @if (DialogOptions.DisplayCancelBtn)
        {
            string cancelText = string.IsNullOrEmpty(DialogOptions.CancelText) ? "Cancel" : DialogOptions.CancelText;
            <MudButton Color="@Color.Error" Variant="Variant.Filled" OnClick="Cancel">@cancelText</MudButton>
        }
        @if (DialogOptions.DisplayOkBtn)
        {
            string okText = string.IsNullOrEmpty(DialogOptions.OkText) ? "Ok" : DialogOptions.OkText;
            <MudButton Color="@Color.Primary" Variant="Variant.Filled" OnClick="Submit">@okText</MudButton>
        }
    </DialogActions>
</MudDialog>