@inherits LayoutComponentBase

<MudLayout>
  <MudAppBar Elevation="1" Dense="true">
    <MudIconButton Icon="@Icons.Material.Filled.Menu"
                   Color="Color.Inherit"
                   Edge="Edge.Start"
                   OnClick="@ToggleOverlay" />
    <MudText Typo="Typo.h6" Class="ml-2">Pocket Budget</MudText>
    <MudSpacer />
    <MudIconButton Icon="@Icons.Custom.Brands.GitHub"
                   Color="Color.Inherit"
                   Href="https://github.com/MudBlazor/MudBlazor" Target="_blank" />
  </MudAppBar>
  
  <MudHidden Breakpoint="Breakpoint.MdAndDown">
    <MudDrawer Open="false"
               Variant="DrawerVariant.Mini"
               ClipMode="DrawerClipMode.Always"
               Elevation="1"
               Anchor="Anchor.Left">
      <MudNavMenu>
        <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Store">Store</MudNavLink>
        <MudNavLink Href="/library" Icon="@Icons.Material.Filled.LibraryBooks">Library</MudNavLink>
        <MudNavLink Href="/community" Icon="@Icons.Material.Filled.Group">Community</MudNavLink>
      </MudNavMenu>
    </MudDrawer>
  </MudHidden>
  
  <MudDrawer Open="@_overlayOpen"
             OpenChanged="OnOverlayChanged"
             Variant="DrawerVariant.Temporary"
             ClipMode="DrawerClipMode.Always"
             Elevation="2"
             Anchor="Anchor.Left">
    <MudNavMenu>
      <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Store">Store</MudNavLink>
      <MudNavLink Href="/library" Icon="@Icons.Material.Filled.LibraryBooks">Library</MudNavLink>
      <MudNavLink Href="/community" Icon="@Icons.Material.Filled.Group">Community</MudNavLink>
    </MudNavMenu>
  </MudDrawer>

  <MudMainContent>
    @Body
  </MudMainContent>

</MudLayout>

@code {
  private bool _overlayOpen = false;

  private void ToggleOverlay()
  {
      _overlayOpen = !_overlayOpen;
  }

  private void OnOverlayChanged(bool isOpen)
  {
      _overlayOpen = isOpen;
  }
}
