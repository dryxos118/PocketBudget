@page "/register"
@using PocketWeb.Components.Register

<div class="container-fluid">
    <div class="row vh-100">
        <div class="col-md-4 d-none d-md-block p-0">
            <img src="img/PocketBack.svg"
                 alt="Login illustration"
                 class="img-fluid h-100 w-100"
                 style="object-fit: cover;"/>
        </div>
        <div class="col-12 col-md-8 d-flex align-items-center justify-content-center">
            <div class="w-75">
                <PocketPanel Title="S'inscrire">
                    <PanelContent>
                        <RegisterForm/>
                    </PanelContent>
                </PocketPanel>
            </div>
        </div>
    </div>
</div>